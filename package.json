{
  "name": "spd-soltau-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website des SPD Ortsvereins Soltau – statisch generiert, Inhalte aus dem Wix-Backend (Headless).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "protect": "node protect.mjs",
    "build:preview": "node build.mjs && node protect.mjs",
    "serve": "node serve.mjs",
    "serve:protected": "node serve.mjs --protected",
    "dev": "node build.mjs && node serve.mjs",
    "push": "node push/send.mjs",
    "push:setup": "node push/setup.mjs",
    "push:test": "node push/send.mjs --test"
  },
  "dependencies": {
    "@wix/blog": "^1.0.0",
    "@wix/data": "^1.0.0",
    "@wix/events": "^1.0.0",
    "@wix/media": "^1.0.276",
    "@wix/members": "^1.0.519",
    "@wix/sdk": "^1.15.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "staticrypt": "^3.5.0"
  }
}
